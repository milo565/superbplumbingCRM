# PostgreSQL (required). Local Docker default:
DATABASE_URL="postgresql://superbflow:superbflow@localhost:5432/superbflow"

# Neon / production example (use the unpooled / direct URL for prisma migrate deploy):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
# Production: https://crm.superbflowplumbing.com.au  (or your Vercel URL)
NEXTAUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Optional: require admin approval before outbound follow-up SMS/email
FOLLOWUP_REQUIRE_APPROVAL="true"

# Optional maps keys — the demo works without them.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY="your-maps-embed-api-key"
# NEXT_PUBLIC_APPLE_MAPS_TOKEN=""

# Optional in-app SuperbBOT assistant (server-only — never expose to the browser)
# Get a key at https://console.x.ai
# XAI_API_KEY=""
# XAI_MODEL="grok-4"
