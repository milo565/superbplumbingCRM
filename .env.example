# SQLite for local demo. Swap to PostgreSQL in production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/superbflow"
DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Optional: require admin approval before outbound follow-up SMS/email
FOLLOWUP_REQUIRE_APPROVAL="true"

# Optional maps keys — the demo works without them.
# Google iframe uses an address query embed when this is empty.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY="your-maps-embed-api-key"
# Optional Apple MapKit JS JWT (Maps Identifier). Without it, Apple Maps
# still opens via https://maps.apple.com/?q=...
# NEXT_PUBLIC_APPLE_MAPS_TOKEN=""
